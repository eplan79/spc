    <li class="cell"><span class="pill gray">완료</span><div class="t"><b>프로모션 동의 문의</b><span>10/15 요청 · 10/16 완료</span></div></li>
   </ul>`;
}
function chat(){
  return hdr('AI매니저','#/home')+`<div class="chat">
   <div class="muted">이 점포의 데이터만 답합니다 · 기준 시점 10/20 13:40</div>
   <div class="q">오늘 많이 팔린 게 뭐지</div>
   <div class="a"><b>오늘 판매 상위 3개</b> (13:40 기준, 수량)<br>1. 핫도그도넛 38 · 2. 에그쉬림프 샌드위치 31(품절) · 3. No.1우유식빵 27<br>전주 월요일 같은 시간보다 샌드위치가 20% 많습니다.<div class="src">조회 조건: 구리인창2호 · 10/20 · 판매수량 기준 · 상품별 매출현황과 같은 수치</div>
    <div class="sugg"><button data-go="#/order">내일 주문에 반영</button><button data-go="#/sales">상품별 매출 보기</button></div></div>
   <div class="sugg" style="margin-top:14px"><button>내일 주문 필요한 품목</button><button>인근 점포 비교</button><button>어제 매출 확정?</button><button>포장재 변경 공지 요약</button></div>
  </div>`;
}

/* ---------- render ---------- */
function render(){
  const r=S.route; const v=document.getElementById('view'); let h='';
  document.getElementById('roleTag').textContent=S.role==='owner'?`가맹점주 · ${S.store}`:'SV · 영업 2본부';
  if(r==='#/home'){ h=S.role==='owner'?homeOwner():homeSV(); tabs('home'); }
  else if(r==='#/order'||r==='#/order/search'){ h=orderList(r==='#/order/search'); tabs('order'); }
  else if(r==='#/order/sold'){ h=soldOrder(); tabs('order'); }
  else if(r==='#/order/confirm'){ h=orderConfirm(); tabs('order'); }
  else if(r==='#/easy'){ S.mode='easy'; h=easy(); tabs('order'); }
  else if(r==='#/scan'){ h=scanScreen(); tabs(''); }
  else if(r==='#/sales'){ h=sales(); tabs('sales'); }
  else if(r==='#/notice'){ h=notice(); tabs('notice'); }
  else if(r==='#/chat'){ h=chat(); tabs('chat'); }
  else { h=homeOwner(); tabs('home'); }
  if(S.toast) h+=`<div class="toast">${S.toast}</div>`;
  if(S.showConflict) h+=conflictSheet();
  if(S.showStore) h+=storeSheet();
  if(S.showDate) h+=dateSheet();
  if(S.showMenu) h+=menuSheet();
  const cta=document.getElementById('cta'); let ctaHtml='';
  h=h.replace(/<div class="fixedbar">[\s\S]*?<\/button><\/div>/,m=>{ctaHtml=m;return '';});
  v.innerHTML=h; bind(v);
  cta.innerHTML=ctaHtml?(isEasy()&&S.route==='#/easy'?`<div class="easy">${ctaHtml}</div>`:ctaHtml):''; bind(cta); renderIndex();
  if(S.scrollTo){ const el=document.getElementById('it-'+S.scrollTo); if(el) el.scrollIntoView({block:'center'}); S.scrollTo=null; }
}
function bind(v){
  v.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{S.showMenu=false;go(b.dataset.go);});
  v.querySelectorAll('[data-cat]').forEach(b=>b.onclick=()=>{S.cat=b.dataset.cat;render();});
  v.querySelectorAll('[data-q]').forEach(b=>b.onclick=()=>{const id=b.dataset.q;S.qty[id]=Math.max(0,S.qty[id]+ +b.dataset.d);render();});
  v.querySelectorAll('[data-in]').forEach(i=>i.onchange=()=>{S.qty[i.dataset.in]=Math.max(0,parseInt(i.value)||0);render();});
  v.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{S.open[b.dataset.open]=!S.open[b.dataset.open];render();});
  v.querySelectorAll('[data-rs]').forEach(b=>b.onclick=()=>{S.reasons[b.dataset.rs]=b.dataset.r;render();});
  v.querySelectorAll('[data-pick]').forEach(b=>b.onclick=()=>{S.easyPick=b.dataset.pick;S.keyval='';S.easyStep=2;render();});
  v.querySelectorAll('[data-key]').forEach(b=>b.onclick=()=>{const k=b.dataset.key; if(k==='C')S.keyval='0'; else if(k==='B')S.keyval=S.keyval.slice(0,-1)||'0'; else S.keyval=(S.keyval==='0'||S.keyval==='')?k:(S.keyval+k).slice(0,3); render();});
  const q=v.querySelector('#q'); if(q){ q.oninput=()=>{S.q=q.value; const pos=q.selectionStart; render(); const nq=document.getElementById('q'); if(nq){nq.focus();nq.setSelectionRange(pos,pos);} if(S.q&&S.route!=='#/order/search'){S.route='#/order/search';renderIndex();} }; }
  v.querySelectorAll('[data-act]').forEach(b=>b.onclick=()=>act(b.dataset.act));
  v.querySelectorAll('[data-r="#/scan"]').forEach(b=>b.onclick=()=>{S.scanHit=null;S.scanMode='search';go('#/scan');});
  v.querySelectorAll('[data-scanmode]').forEach(b=>b.onclick=()=>{S.scanMode=b.dataset.scanmode;S.scanHit=null;render();});
  v.querySelectorAll('[data-inq]').forEach(b=>b.onclick=()=>{const i=items().find(x=>x.id===b.dataset.inq);const exp=i.incoming||Math.max(2,Math.round(i.avg14d||3));S.inQty[i.id]=Math.max(0,(S.inQty[i.id]??exp)+ +b.dataset.d);render();});
  v.querySelectorAll('[data-rkadd]').forEach(b=>b.onclick=()=>{const id=b.dataset.rkadd; const i=items().find(x=>x.id===id); if(i.notCarried){S.qty[id]=(S.qty[id]||0)+1;} S.scrollTo=id; S.open[id]=true; render(); toast(i.notCarried?'주문 목록에 담았습니다':'해당 품목으로 이동했습니다');});
  v.querySelectorAll('[data-sq]').forEach(b=>b.onclick=()=>{const i=items().find(x=>x.id===b.dataset.sq);S.soldQty[i.id]=Math.max(0,(S.soldQty[i.id]??i.todaySales)+ +b.dataset.d);render();});
  v.querySelectorAll('[data-sin]').forEach(e=>e.onchange=()=>{S.soldQty[e.dataset.sin]=Math.max(0,parseInt(e.value)||0);render();});
  v.querySelectorAll('[data-date]').forEach(b=>b.onclick=()=>{S.orderDate=+b.dataset.date;S.showDate=false;render();});
  v.querySelectorAll('[data-store]').forEach(b=>b.onclick=()=>{S.store=b.dataset.store;S.showStore=false;render();toast(`${S.store}으로 전환했습니다`);});
  v.querySelectorAll('[data-menu]').forEach(b=>b.onclick=()=>{const m=b.dataset.menu; S.showMenu=false; const map={'주문 등록':isEasy()?'#/easy':'#/order','주문 현황':'#/order','일자별 종합 매출':'#/sales','월별 매출':'#/sales','상품별 매출':'#/sales','시간대별 매출':'#/sales','점포 매출 순위':'#/sales','공지사항':'#/notice','자료공유방':'#/notice','점포 요청·컨설팅':'#/notice','AI매니저':'#/chat'}; if(map[m]) go(map[m]); else {render(); toast(`${m} — 시연 범위 밖 화면입니다`);} });
  const mq=v.querySelector('#mq'); if(mq){ mq.oninput=()=>{S.menuQ=mq.value; const p=mq.selectionStart; render(); const n=document.getElementById('mq'); if(n){n.focus();n.setSelectionRange(p,p);} }; }
}
function act(a){
  if(a==='date'){ S.showDate=true; render(); }
  else if(a==='date-close'){ S.showDate=false; render(); }
  else if(a==='scat-prev'||a==='scat-next'){ const c=soldCats(); let i=c.indexOf(S.soldCat); i=(i+(a==='scat-next'?1:-1)+c.length)%c.length; S.soldCat=c[i]; render(); }
  else if(a==='sold-reset'){ S.soldQty={}; render(); toast('당일 판매 수량으로 되돌렸습니다'); }
  else if(a==='sold-save'){ soldItems().forEach(i=>{S.qty[i.id]=S.soldQty[i.id]??i.todaySales;}); go('#/order/confirm'); }
  else if(a==='cat-prev'||a==='cat-next'){ let i=CATS.indexOf(S.cat); i=(i+(a==='cat-next'?1:-1)+CATS.length)%CATS.length; S.cat=CATS[i]; render(); }
  else if(a==='hsearch'){ S.showSearch=!S.showSearch; if(!S.showSearch){S.q='';} if(S.route==='#/home'){ go('#/order'); S.showSearch=true; render(); } else render(); if(S.showSearch){const q=document.getElementById('q'); if(q) q.focus();} }
  else if(a==='scan-close'){ S.scanHit=null; go('#/home'); }
  else if(a==='scan-hit'){ S.scanHit=S.scanMode==='check'?'P029':(S.scanMode==='tag'?'P008':'P011'); render(); }
  else if(a==='scan-clear'){ S.scanHit=null; render(); }
  else if(a==='scan-tomode-check'){ S.scanMode='check'; render(); }
  else if(a==='scan-order'){ const id=S.scanHit; S.qty[id]=(S.qty[id]||0)+1; S.scanHit=null; S.scrollTo=id; S.open[id]=true; go(isEasy()?'#/easy':'#/order'); toast('주문 목록에 담았습니다'); }
  else if(a==='scan-damage'){ toast('파손·불량 사진 첨부 → 반품 등록으로 연결 (시연 범위 밖)'); }
  else if(a==='scan-confirm'){ S.scanHit=null; render(); toast('검수 확정 · 재고에 반영했습니다'); }
  else if(a==='scan-print'){ S.scanHit=null; render(); toast('가격표 1장을 인쇄했습니다'); }
  else if(a==='alert-next'){ S.alertIdx++; render(); }
  else if(a==='oos'){ toast('시연 범위 밖 화면입니다'); }
  else if(a==='store'){ S.showStore=true; render(); }
  else if(a==='store-close'){ S.showStore=false; render(); }
  else if(a==='menu'){ S.showMenu=true; S.menuQ=''; render(); }
  else if(a==='menu-close'){ S.showMenu=false; render(); }
  else if(a==='mode'){ S.mode=isEasy()?'improved':'easy'; go(isEasy()?'#/easy':'#/order'); }
  else if(a==='recover'){ S.draft.items.forEach(x=>S.qty[x.id]=x.q); S.recovered=true; S.scrollTo=S.draft.scroll; S.open[S.draft.scroll]=true; S.draft=null; render(); toast('13:41 입력 내용을 복구했습니다'); }
  else if(a==='discard'){ S.draft=null; render(); }
  else if(a==='applyall'){ items().forEach(i=>S.qty[i.id]=S.base[i.id]); render(); toast('권고수량을 모두 적용했습니다'); }
  else if(a==='recent'){ S.cat='전체'; S.q=''; render(); toast('최근 15일 주문 품목 순으로 정렬'); }
  else if(a==='save'){ if(S.conflictArmed){ S.showConflict=true; S.conflictArmed=false; render(); } else { S.draft=null; toast('저장했습니다 · 본사 전송 대기'); setTimeout(()=>{S.base={...S.qty};go('#/home');},1200); } }
  else if(a==='conflict-mine'||a==='conflict-theirs'){ if(a==='conflict-theirs'){S.qty.P029=6;S.qty.P008=4;} S.showConflict=false; toast('저장했습니다 · 본사 전송 대기'); setTimeout(()=>{S.base={...S.qty};go('#/home');},1200); }
  else if(a==='easy1'){ S.easyStep=1; render(); }
  else if(a==='easy3'){ S.easyStep=3; render(); }
  else if(a==='easyrec'){ const i=items().find(x=>x.id===S.easyPick); S.qty[i.id]=i.recommend||0; S.keyval=''; S.easyStep=1; render(); }
  else if(a==='easyok'){ const i=items().find(x=>x.id===S.easyPick); if(S.keyval!=='') S.qty[i.id]=parseInt(S.keyval)||0; S.keyval=''; S.easyStep=1; render(); }
}
window.addEventListener('hashchange',()=>{ const r=location.hash||'#/home'; if(r!==S.route){S.route=r;render();} });
S.route=location.hash||'#/home'; render();
setInterval(()=>{const d=new Date();document.getElementById('clock').textContent=`${d.getHours()}:${String(d.getMinutes()).padStart(2,'0')}`;},30000);
</script>
