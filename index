<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>파리크라상 모바일 점포관리 — UX 시안 프로토타입 v0.1</title>
<style>
:root{
  --pri:#1F4E9C; --pri-d:#163A75; --sub:#EEF3FA; --warn:#D23F31;
  --ink:#1B1B1B; --ink-2:#55585E; --ink-3:#8A8F98; --line:#E3E6EB; --bg:#F6F7F9; --card:#FFFFFF;
  --r:12px; --font:"Pretendard","Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:var(--font);background:#DFE3E8;color:var(--ink);font-size:14px;-webkit-font-smoothing:antialiased}
button{font-family:inherit;font-size:inherit;color:inherit;background:none;border:0;cursor:pointer;max-height:64px}
input{font-family:inherit;font-size:inherit}

/* ===== stage ===== */
.stage{display:flex;gap:28px;align-items:flex-start;justify-content:center;padding:28px 20px;min-height:100vh}
.phone{width:390px;height:844px;background:#111;border-radius:44px;padding:12px;box-shadow:0 20px 60px rgba(0,0,0,.35);flex:none;position:relative}
.screen{width:100%;height:100%;background:var(--bg);border-radius:34px;overflow:hidden;position:relative;display:flex;flex-direction:column}
.notch{height:44px;flex:none;background:var(--card);display:flex;align-items:center;justify-content:space-between;padding:0 22px;font-size:12px;color:var(--ink-2);border-bottom:1px solid var(--line)}
.notch b{font-weight:600;color:var(--ink)}
.view{flex:1;overflow:auto;position:relative}
.view::-webkit-scrollbar{width:0}
.tabbar{height:64px;flex:none;background:var(--card);border-top:1px solid var(--line);display:flex}
.tabbar button{flex:1;min-width:64px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;color:var(--ink-3)}
.tabbar button.on{color:var(--pri);font-weight:600}
.tabbar .ico{width:24px;height:24px;display:block}
.tabbar .ico svg{width:24px;height:24px}
.tabbar button.scan{overflow:hidden}
.tabbar .scanbtn{width:48px;height:48px;border-radius:50%;background:var(--pri);color:#fff;display:flex;align-items:center;justify-content:center}
.tabbar .scanbtn svg{width:26px;height:26px}

/* ===== index panel ===== */
.index{width:320px;flex:none;background:var(--card);border-radius:14px;padding:18px 16px;box-shadow:0 8px 30px rgba(0,0,0,.12);max-height:844px;overflow:auto;position:sticky;top:28px}
.index h1{font-size:15px;font-weight:700;line-height:1.35}
.index .sub{font-size:12px;color:var(--ink-3);margin:4px 0 14px}
.index h2{font-size:12px;color:var(--ink-2);font-weight:600;margin:14px 0 6px;padding-bottom:4px;border-bottom:1px solid var(--line)}
.index ul{list-style:none}
.index li button{width:100%;text-align:left;padding:7px 10px;border-radius:8px;font-size:13px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.index li button:hover{background:var(--sub)}
.index li button.on{background:var(--pri);color:#fff}
.index li button small{font-size:11px;color:var(--ink-3)}
.index li button.on small{color:#fff;opacity:.8}
.index .act{color:var(--pri);font-weight:600}
.index .act::before{content:"▶";font-size:9px;margin-right:6px}
.index .state{margin-top:14px;padding:10px;background:var(--sub);border-radius:8px;font-size:12px;color:var(--ink-2);line-height:1.5}
.index .state b{color:var(--ink)}

/* ===== common ===== */
.hdr{position:sticky;top:0;z-index:5;background:var(--card);border-bottom:1px solid var(--line);padding:10px 16px;display:flex;align-items:center;gap:10px;min-height:52px}
.hdr .ttl{font-size:17px;font-weight:700;flex:1}
.hdr .back{width:32px;height:32px;border-radius:8px;font-size:18px;display:flex;align-items:center;justify-content:center}
.hdr .back:active{background:var(--sub)}
.chipbtn{padding:6px 10px;border-radius:999px;border:1px solid var(--line);font-size:12px;color:var(--ink-2);background:var(--card)}
.chipbtn.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.sec{padding:16px 16px 8px;font-size:13px;font-weight:700;color:var(--ink-2)}
.card{background:var(--card);border-radius:var(--r);margin:0 16px 12px;padding:14px;border:1px solid var(--line)}
.card h3{font-size:14px;font-weight:700;margin-bottom:8px}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.muted{color:var(--ink-3);font-size:12px}
.big{font-size:22px;font-weight:700;letter-spacing:-.3px}
.delta{font-size:12px;font-weight:600}
.delta.up{color:var(--pri)} .delta.down{color:var(--warn)}
.btn{display:flex;align-items:center;justify-content:center;min-height:48px;min-width:96px;white-space:nowrap;padding:0 14px;border-radius:12px;font-weight:700;font-size:15px}
.btn.pri{background:var(--pri);color:#fff}.btn.pri:active{background:var(--pri-d)}
.btn.sec{background:var(--sub);color:var(--pri)}
.btn.ghost{border:1px solid var(--line);background:var(--card)}
.btn.warn{background:var(--warn);color:#fff}
.btn[disabled]{opacity:.4}
.pill{display:inline-block;padding:2px 7px;border-radius:6px;font-size:11px;font-weight:600;background:var(--sub);color:var(--pri);vertical-align:middle}
.pill.warn{background:#FBE9E7;color:var(--warn)}
.pill.gray{background:#EEF0F3;color:var(--ink-2)}
.banner{margin:12px 16px 0;padding:12px 14px;border-radius:10px;background:var(--sub);border:1px solid #D7E2F5;font-size:13px;line-height:1.5}
.banner.warn{background:#FBE9E7;border-color:#F3C9C4}
.banner .row{margin-top:8px}
.banner .btn{min-height:36px;font-size:13px;padding:0 14px;border-radius:8px}
.toast{position:absolute;left:16px;right:16px;bottom:80px;background:var(--ink);color:#fff;padding:12px 14px;border-radius:10px;font-size:13px;z-index:30;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.sheet-bg{position:absolute;inset:0;background:rgba(0,0,0,.4);z-index:40;display:flex;align-items:flex-end}
.sheet{background:var(--card);width:100%;border-radius:18px 18px 0 0;padding:18px 16px 24px;max-height:85%;overflow:auto}
.sheet h3{font-size:16px;font-weight:700;margin-bottom:6px}
.sheet .btn{margin-top:10px}
.list{list-style:none}
.cell{display:flex;gap:12px;padding:12px 16px;background:var(--card);border-bottom:1px solid var(--line);align-items:center}
.cell .t{flex:1;min-width:0}.cell .t b{display:block;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cell .t span{font-size:12px;color:var(--ink-3)}
.tap{min-height:48px}
.fixedbar{flex:none;background:var(--card);border-top:1px solid var(--line);padding:10px 16px;display:flex;gap:10px;z-index:5;overflow-x:auto}
#cta{flex:none}
#cta .easy .btn{min-height:56px;font-size:17px}
.fixedbar::-webkit-scrollbar{height:0}
.fixedbar .btn{flex:1 0 auto}
.kpi{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.kpi div{background:var(--sub);border-radius:10px;padding:10px}
.kpi small{display:block;font-size:11px;color:var(--ink-2)}
.kpi b{display:block;font-size:16px;margin-top:2px}
.bars{display:flex;align-items:flex-end;gap:4px;height:70px;margin-top:8px}
.bars i{flex:1;background:var(--pri);opacity:.25;border-radius:3px 3px 0 0}
.bars i.hi{opacity:1}
.axis{display:flex;justify-content:space-between;font-size:10px;color:var(--ink-3);margin-top:4px}
.sr{position:absolute;left:-9999px}

/* ===== order (improved) ===== */
.ctx2{background:var(--bg);padding:12px 16px 4px;position:sticky;top:52px;z-index:4;border-bottom:1px solid var(--line)}
.ctx2 .box{display:flex;align-items:center;gap:8px;width:100%;height:48px;border:1px solid var(--line);border-radius:10px;background:var(--card);padding:0 12px;font-size:14px;text-align:left;max-height:none}
.ctx2 .box .ic{display:flex;color:var(--ink-2)}
.ctx2 .box .v{font-weight:700;display:flex;align-items:center;gap:6px}
.ctx2 .box .due{margin-left:auto;font-size:12px;font-weight:700;color:var(--warn)}
.ctx2 .box.cat{margin-top:8px;padding:0}
.ctx2 .box.cat .v{flex:1;justify-content:center}
.ctx2 .box.cat .nav{width:48px;height:46px;display:flex;align-items:center;justify-content:center;color:var(--ink-2)}
.ctx2 .box.cat .nav:first-child{border-right:1px solid var(--line)}.ctx2 .box.cat .nav:last-child{border-left:1px solid var(--line)}
.ctx2 .sub{display:flex;justify-content:space-between;align-items:center;margin-top:6px;font-size:12px;color:var(--ink-2)}
.ctx2 .sub .txtbtn{color:var(--pri);font-weight:700;font-size:12px;padding:6px 0}
.datelist .cell.on{background:var(--sub)}
.search{margin:10px 16px;display:flex;gap:8px}
.search input{flex:1;height:44px;border:1px solid var(--line);border-radius:10px;padding:0 12px;background:var(--card)}
.cats{display:flex;gap:6px;padding:0 16px 8px;overflow:auto}
.cats::-webkit-scrollbar{height:0}
.item{background:var(--card);border-bottom:1px solid var(--line);padding:10px 16px}
.item .top{display:flex;gap:10px;align-items:center}
.item img,.item .noimg{width:48px;height:48px;border-radius:8px;object-fit:cover;flex:none;background:var(--sub)}
.item .nm{flex:1;min-width:0}
.item .nm b{display:block;font-size:14px;line-height:1.3}
.item .nm .meta{font-size:11px;color:var(--ink-3);margin-top:2px;display:flex;gap:6px;flex-wrap:wrap}
.item .facts{display:flex;gap:14px;margin:10px 0 0 58px;font-size:12px;color:var(--ink-2)}
.item .facts span{display:flex;flex-direction:column;gap:2px}
.item .facts small{font-size:11px;color:var(--ink-3)}
.item .facts b{color:var(--ink);font-size:14px}
.item .facts .rec small{color:var(--pri)}
.item .facts .rec b{color:var(--pri)}
.qty{display:flex;align-items:center;gap:4px;margin-left:auto}
.qty button{width:40px;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--card);font-size:20px;font-weight:600}
.qty button:active{background:var(--sub)}
.qty input{width:48px;height:40px;text-align:center;border:1px solid var(--line);border-radius:10px;font-size:16px;font-weight:700}
.qty.changed input{border-color:var(--pri);background:var(--sub)}
.qty.over input{border-color:var(--warn);background:#FBE9E7;color:var(--warn)}
.item .why{margin:8px 0 0 58px;background:var(--sub);border-radius:8px;padding:8px 10px;font-size:12px;line-height:1.5}
.item .why .ttl{font-weight:700;color:var(--pri);margin-bottom:2px}
.item .more{margin:6px 0 0 58px;font-size:12px;color:var(--pri);font-weight:600}
.item .detail{margin:8px 0 0 58px;padding-top:8px;border-top:1px dashed var(--line)}
.item .detail .kpi{grid-template-columns:1fr 1fr 1fr 1fr}
.item .detail .kpi div{padding:6px 8px}
.item .detail .kpi b{font-size:13px}
.reasons{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;margin-top:6px;padding-bottom:2px}
.reasons::-webkit-scrollbar{height:0}
.reasons button{flex:none;white-space:nowrap;padding:5px 9px;border-radius:999px;border:1px solid var(--line);font-size:11px;background:var(--card)}
.reasons button.on{background:var(--pri);color:#fff;border-color:var(--pri)}
.warnmsg{color:var(--warn);font-size:12px;margin:6px 0 0 58px;font-weight:600}

/* ===== easy ===== */
.easy .item{padding:14px 16px}
.easy .item .nm b{font-size:17px}
.easy .qty button{width:52px;height:52px;font-size:26px}
.easy .qty input{width:62px;height:52px;font-size:22px}
.easy .steps{display:flex;gap:6px;padding:12px 16px 4px}
.easy .steps div{flex:1;height:6px;border-radius:3px;background:var(--line)}
.easy .steps div.on{background:var(--pri)}
.easy .stepttl{padding:8px 16px 4px;font-size:20px;font-weight:800}
.easy .stepsub{padding:0 16px 10px;font-size:14px;color:var(--ink-2)}
.easy .ctx{font-size:14px}
.easy .btn{min-height:56px;font-size:17px}
.easy .rbox{flex:none;min-width:72px;height:56px;border:1.5px solid var(--line);border-radius:12px;background:var(--card);display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.1;position:relative}
.easy .rbox b{font-size:22px;font-weight:800}
.easy .rbox small{font-size:11px;color:var(--ink-3);margin-top:2px}
.easy .rbox.ch{border-color:var(--pri);background:var(--sub)}
.easy .rbox.ch b{color:var(--pri)}
.easy .rbox::after{content:"";position:absolute;right:6px;top:50%;width:6px;height:6px;border-right:1.5px solid var(--ink-3);border-bottom:1.5px solid var(--ink-3);transform:translateY(-50%) rotate(-45deg)}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.keypad button{height:56px;min-width:56px;border-radius:12px;background:var(--sub);font-size:22px;font-weight:700}
.keypad button.c{background:var(--line)}
.keyval{font-size:40px;font-weight:800;text-align:center;padding:8px 0}

/* store selector & full menu */
.storesel{display:flex;align-items:center;gap:8px;flex:1;min-width:0;text-align:left}
.storesel .ic{width:28px;height:28px;border-radius:50%;background:var(--sub);flex:none;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--pri);font-weight:800}
.storesel .nm{font-size:16px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.storesel .chev{color:var(--ink-2);display:flex;align-items:center;flex:none;margin-left:2px}
.iconbtn{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex:none}
.iconbtn:active{background:var(--sub)}
.ham{width:20px;height:2px;background:var(--ink);position:relative;display:block}
.ham::before,.ham::after{content:"";position:absolute;left:0;width:20px;height:2px;background:var(--ink)}
.ham::before{top:-6px}.ham::after{top:6px}
.bell{position:relative;font-size:12px;font-weight:700;color:var(--pri);background:var(--sub);border-radius:999px;padding:6px 10px}
.menusheet{position:absolute;inset:0;background:var(--bg);z-index:45;display:flex;flex-direction:column}
.menusheet .body{flex:1;overflow:auto}
.menusheet .grp{padding:14px 16px 6px;font-size:12px;font-weight:700;color:var(--ink-2)}
.menusheet .grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.menusheet .grid button{background:var(--card);min-height:48px;max-height:56px;text-align:left;padding:0 16px;font-size:14px;display:flex;align-items:center;justify-content:space-between}
.menusheet .grid button .pill{font-size:10px}
.storelist .cell{cursor:pointer}
.storelist .cell.on{background:var(--sub)}
.storelist .chk{width:22px;height:22px;border-radius:50%;border:2px solid var(--line);flex:none}
.storelist .on .chk{border-color:var(--pri);background:var(--pri)}
/* scan */
.scan-screen{position:absolute;inset:0;background:#0F1114;color:#fff;display:flex;flex-direction:column;z-index:20}
.scan-top{height:52px;display:flex;align-items:center;justify-content:flex-end;padding:0 10px}
.scan-top .iconbtn{color:#fff}
.scan-body{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding:0 24px}
.finder{width:250px;height:250px;position:relative;background:#1C1F24;border-radius:6px;cursor:pointer}
.finder::before,.finder::after,.finder i::before,.finder i::after{content:"";position:absolute;width:26px;height:26px;border:3px solid #9AA0A8}
.finder::before{top:-8px;left:-8px;border-right:0;border-bottom:0;border-radius:4px 0 0 0}
.finder::after{top:-8px;right:-8px;border-left:0;border-bottom:0;border-radius:0 4px 0 0}
.finder i::before{bottom:-8px;left:-8px;border-right:0;border-top:0;border-radius:0 0 0 4px}
.finder i::after{bottom:-8px;right:-8px;border-left:0;border-top:0;border-radius:0 0 4px 0}
.finder .cross{position:absolute;left:50%;top:50%;width:22px;height:22px;transform:translate(-50%,-50%);color:#3B82F6}
.finder .cross::before,.finder .cross::after{content:"";position:absolute;background:currentColor}
.finder .cross::before{left:50%;top:0;width:2px;height:100%;transform:translateX(-50%)}
.finder .cross::after{top:50%;left:0;height:2px;width:100%;transform:translateY(-50%)}
.scan-guide{font-size:14px;color:#D9DCE1;text-align:center;line-height:1.5}
.scan-tabs{height:76px;display:flex;border-top:1px solid #2A2E35;background:#0F1114}
.scan-tabs button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:12px;color:#9AA0A8;min-width:64px}
.scan-tabs button.on{color:#3B82F6}
.scan-tabs button .ico{width:24px;height:24px}
.scan-tabs button .ico svg{width:24px;height:24px}
.scan-tabs button+button{border-left:1px solid #2A2E35}
.scan-result{position:absolute;left:0;right:0;bottom:76px;background:var(--card);color:var(--ink);border-radius:18px 18px 0 0;padding:18px 16px 20px;z-index:25}
.scan-result h3{font-size:16px;font-weight:700;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center}
.scan-result .prod{display:flex;gap:12px;align-items:center}
.scan-result .prod img{width:64px;height:64px;border-radius:10px;object-fit:cover}
.scan-result .prod b{display:block;font-size:15px}
.scan-result .prod .muted{margin-top:4px;line-height:1.5}
.scan-result .facts{display:flex;gap:14px;margin-top:14px;font-size:13px;color:var(--ink-2)}
.scan-result .facts b{color:var(--ink)}
.scan-result .acts{display:flex;gap:8px;margin-top:16px}
.scan-result .acts .btn{flex:1;min-height:46px}
.label{margin-top:14px;border:1px dashed var(--line);border-radius:10px;padding:14px;text-align:center}
.label .nm{font-size:14px;font-weight:700}
.label .pr{font-size:24px;font-weight:800;margin:4px 0}
.label .bc{height:34px;margin:8px auto 2px;width:180px;background:repeating-linear-gradient(90deg,#1B1B1B 0 2px,transparent 2px 4px,#1B1B1B 4px 7px,transparent 7px 9px,#1B1B1B 9px 10px,transparent 10px 13px)}
.label .code{font-size:11px;color:var(--ink-3);letter-spacing:2px}
/* home v2 */
.alertbar{background:#2E3137;color:#fff;padding:10px 16px;display:flex;align-items:center;gap:10px;font-size:13px}
.alertbar .tag{background:var(--warn);color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:999px;flex:none}
.alertbar .msg{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left}
.alertbar .cnt{font-size:12px;opacity:.8;flex:none}
.psearch{margin:16px 16px 0;height:48px;border:1.5px solid var(--line);border-radius:14px;background:var(--card);display:flex;align-items:center;gap:8px;padding:0 10px 0 14px;color:var(--ink-3)}
.psearch input{flex:1;height:100%;border:0;background:none;font-size:14px;color:var(--ink)}
.psearch .iconbtn{width:36px;height:36px;color:var(--ink-2)}
.qm{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 8px;margin:18px 16px 0}
.qm button{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;color:var(--ink);padding:0;height:auto;max-height:none}
.qm button .ic{width:56px;height:56px;border-radius:16px;background:var(--sub);color:var(--pri);display:flex;align-items:center;justify-content:center}
.qm button .ic svg{width:26px;height:26px}
.qm button.g .ic{color:#2F7D5B;background:#E8F3EE}
.qm button.o .ic{color:#B9641B;background:#FBEFE3}
.status{margin:16px 16px 0;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:18px 16px}
.status h3{font-size:15px;font-weight:700;display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.status h3 .pill{font-size:11px}
.status .line{display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--line);font-size:13px}
.status .line:last-of-type{border-bottom:0}
.status .line.noline{border-bottom:0;padding-bottom:0}
.status .line b{font-weight:700}
.status .btn{margin-top:16px;min-height:44px}
.ochk{background:var(--sub);border-radius:12px;padding:18px 16px;margin:12px 0 8px}
.ochk .muted{line-height:1.6}
.ochk .big{font-size:24px;line-height:1.3}
.ochk .amt{display:flex;align-items:center;gap:6px;margin:4px 0;max-height:none;padding:0}
.ochk .chevr{display:flex;color:var(--ink-2);transform:rotate(-90deg)}
.stack{display:flex;height:10px;border-radius:5px;overflow:hidden;margin-top:16px}
.stack i{display:block;height:100%}
